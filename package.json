{
  "name": "orcastrator",
  "version": "0.2.0",
  "type": "module",
  "bin": {
    "orca": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "bun run src/cli/index.ts",
    "lint": "oxlint src/",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "start": "bun run src/cli/index.ts",
    "prepare": "husky",
    "postbuild": "chmod +x dist/cli/index.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.47",
    "@inquirer/prompts": "^8.2.1",
    "chalk": "^5.3.0",
    "commander": "^13.1.0",
    "orca-codex-client": "^0.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "^1.2.21",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.0",
    "oxlint": "^0.15.14",
    "typescript": "^5.8.2"
  },
  "lint-staged": {
    "*.ts": [
      "oxlint --fix"
    ]
  },
  "files": [
    "dist/**/*.js",
    "!dist/**/*.test.js",
    "README.md"
  ],
  "description": "Coordinated agent run harness",
  "author": "ratley",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ratley/orca.git"
  },
  "keywords": [
    "ai",
    "agent",
    "codex",
    "claude",
    "orchestration",
    "cli"
  ]
}
