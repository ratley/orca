{
  "name": "orcastrator",
  "version": "0.2.20",
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    }
  },
  "bin": {
    "orca": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "bun run src/cli/index.ts",
    "lint": "oxlint src/",
    "typecheck": "node ./scripts/typecheck.mjs",
    "test": "bun test src",
    "test:setup": "bash scripts/test-setup.sh",
    "test:postexec-json": "bun test src/cli/commands/run.postexec-json.integration.test.ts",
    "start": "bun run src/cli/index.ts",
    "prepare": "husky",
    "postbuild": "chmod +x dist/cli/index.js",
    "lint:type-aware": "oxlint --type-aware --type-check --deny-warnings src/ --ignore-pattern \"**/*.test.ts\"",
    "typecheck:native": "tsgo --noEmit",
    "typecheck:tsc": "tsc --noEmit",
    "validate": "npm run lint && npm run lint:type-aware && npm run typecheck && npm run test && npm run build",
    "smoke:hooks": "npm run build && node ./specs/smoke/hooks/run-hooks-smoke.mjs",
    "type:check": "tsc -p tsconfig.json --noEmit",
    "pkg:lint": "publint",
    "pkg:attw": "attw -P . --profile esm-only",
    "consumer:smoke": "node ./scripts/smoke-consumer-types.mjs",
    "validate:package-types": "npm run build && npm run type:check && npm run pkg:lint && npm run pkg:attw && npm run consumer:smoke"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.47",
    "@inquirer/prompts": "^8.2.1",
    "@ratley/codex-client": "^0.1.3",
    "chalk": "^5.3.0",
    "commander": "^13.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.2.21",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.0",
    "oxlint": "^1.49.0",
    "typescript": "^5.8.2",
    "@typescript/native-preview": "^7.0.0-dev.20260219.1",
    "oxlint-tsgolint": "^0.14.1",
    "publint": "^0.3.15",
    "@arethetypeswrong/cli": "^0.17.4"
  },
  "lint-staged": {
    "*.ts": [
      "oxlint --fix"
    ]
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "!dist/**/*.test.js",
    "README.md",
    ".orca/skills/**/SKILL.md"
  ],
  "description": "Coordinated agent run harness",
  "author": "ratley",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ratley/orca.git"
  },
  "homepage": "https://orcastrator.dev",
  "bugs": {
    "url": "https://github.com/ratley/orca/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "codex",
    "claude",
    "orchestration",
    "cli"
  ]
}
