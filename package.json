{
  "name": "orcastrator",
  "version": "0.2.25",
  "description": "Observable agent-lane harness",
  "keywords": [
    "agent",
    "ai",
    "cli",
    "codex",
    "orchestration"
  ],
  "homepage": "https://orcastrator.dev",
  "bugs": {
    "url": "https://github.com/happycatlabs/orca/issues"
  },
  "license": "MIT",
  "author": "ratley",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/happycatlabs/orca.git"
  },
  "bin": {
    "orca": "dist/cli/index.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "!dist/**/*.test.js",
    "!dist/**/__tests__/**",
    "README.md",
    "skills/**/SKILL.md",
    "skills/**/scripts/**/*.py"
  ],
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "dev": "bun run src/cli/index.ts",
    "lint": "oxlint src/",
    "typecheck": "node ./scripts/typecheck.mjs",
    "test": "bun test src",
    "start": "bun run src/cli/index.ts",
    "prepare": "husky",
    "postbuild": "chmod +x dist/cli/index.js",
    "lint:type-aware": "oxlint --type-aware --type-check --deny-warnings src/ --ignore-pattern \"**/*.test.ts\"",
    "typecheck:native": "tsgo --noEmit",
    "typecheck:tsc": "tsc --noEmit",
    "validate": "npm run lint && npm run lint:type-aware && npm run typecheck && npm run test && npm run build",
    "type:check": "tsc -p tsconfig.json --noEmit",
    "pkg:lint": "publint",
    "pkg:attw": "attw -P . --profile esm-only",
    "consumer:smoke": "node ./scripts/smoke-consumer-types.mjs",
    "validate:package-types": "npm run build && npm run type:check && npm run pkg:lint && npm run pkg:attw && npm run consumer:smoke"
  },
  "dependencies": {
    "@happycatlabs/codex-client": "^0.2.1",
    "commander": "^13.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.17.4",
    "@types/bun": "^1.2.21",
    "@types/node": "^25.8.0",
    "@typescript/native-preview": "^7.0.0-dev.20260219.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.0",
    "oxfmt": "^0.49.0",
    "oxlint": "^1.64.0",
    "oxlint-tsgolint": "^0.22.1",
    "publint": "^0.3.15",
    "typescript": "^5.8.2"
  },
  "lint-staged": {
    "*.ts": [
      "oxlint --fix"
    ]
  }
}
